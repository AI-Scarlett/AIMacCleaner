    "advisor.systemData.managed": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يديره macOS، لا يُحذف مباشرة" } },
        "de": { "stringUnit": { "state": "translated", "value": "Von macOS verwaltet, nicht direkt löschen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Managed by macOS; do not delete directly" } },
        "es": { "stringUnit": { "state": "translated", "value": "Gestionado por macOS; no eliminar directamente" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Géré par macOS ; ne pas supprimer directement" } },
        "ja": { "stringUnit": { "state": "translated", "value": "macOS 管理（直接削除しない）" } },
        "ko": { "stringUnit": { "state": "translated", "value": "macOS 관리 항목(직접 삭제 안 함)" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Gerido pelo macOS; não eliminar diretamente" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Управляется macOS; не удалять напрямую" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "macOS 管理，不直接删除" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "macOS 管理，不直接刪除" } }
      }
    },
    "advisor.systemData.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تم قياس %@ للقراءة فقط؛ قد تتضمن «بيانات النظام» في macOS مساحة APFS قابلة للتطهير وبيانات محمية، لذا لا يمكن اعتبار إجمالي الإعدادات مساحة قابلة للحذف.%@" } },
        "de": { "stringUnit": { "state": "translated", "value": "Schreibgeschützt gemessen: %@. „Systemdaten“ kann löschbaren APFS-Speicher und geschützte Daten enthalten; die Gesamtsumme in den Einstellungen ist daher nicht direkt löschbar.%@" } },
        "en": { "stringUnit": { "state": "translated", "value": "Read-only measurement: %@. macOS System Data can also include APFS purgeable space and protected data, so the Storage Settings total is not directly deletable.%@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Medición de solo lectura: %@. Datos del sistema también puede incluir espacio APFS purgable y datos protegidos; el total de Ajustes no se puede eliminar directamente.%@" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Mesure en lecture seule : %@. Les données système peuvent inclure de l’espace APFS purgeable et des données protégées ; le total des Réglages n’est donc pas directement supprimable.%@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "読み取り専用で %@ を測定しました。macOS の「システムデータ」には APFS の消去可能領域や保護データも含まれるため、設定の合計値をそのまま削除することはできません。%@" } },
        "ko": { "stringUnit": { "state": "translated", "value": "읽기 전용으로 %@를 측정했습니다. macOS 시스템 데이터에는 APFS 제거 가능 공간과 보호된 데이터가 포함될 수 있으므로 설정의 합계는 직접 삭제할 수 없습니다.%@" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Medição só de leitura: %@. Os Dados do Sistema podem incluir espaço APFS purgável e dados protegidos; o total das Definições não pode ser eliminado diretamente.%@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Только для чтения измерено: %@. Системные данные macOS могут включать очищаемое пространство APFS и защищённые данные, поэтому итог из Настроек нельзя удалить напрямую.%@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本次只读测得 %@；macOS 的“系统数据”还可能包含 APFS 可清除空间和受保护数据，不能把系统设置中的总数直接当作可删除空间。%@" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "本次唯讀測得 %@；macOS 的「系統資料」還可能包含 APFS 可清除空間和受保護資料，不能把系統設定中的總數直接當作可刪除空間。%@" } }
      }
    },
    "advisor.systemData.truncated": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": " لم تكتمل بعض المسارات بسبب حدود الوقت أو الأذونات أو وحدات التخزين؛ المعروض هو الجزء الذي تم قياسه." } },
        "de": { "stringUnit": { "state": "translated", "value": " Einige Pfade wurden wegen Zeit-, Berechtigungs- oder Volume-Grenzen nicht vollständig gemessen; angezeigt wird der gemessene Teil." } },
        "en": { "stringUnit": { "state": "translated", "value": " Some paths could not be fully measured because of time, permission, or volume boundaries; values show the measured portion." } },
        "es": { "stringUnit": { "state": "translated", "value": " Algunas rutas no se midieron por completo debido a límites de tiempo, permisos o volúmenes; se muestra la parte medida." } },
        "fr": { "stringUnit": { "state": "translated", "value": " Certains chemins n’ont pas pu être entièrement mesurés en raison de limites de temps, d’autorisations ou de volumes ; seule la partie mesurée est affichée." } },
        "ja": { "stringUnit": { "state": "translated", "value": " 時間、権限、またはボリューム境界により一部のパスを完全に測定できなかったため、測定済み部分のみ表示しています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": " 시간, 권한 또는 볼륨 경계로 인해 일부 경로를 완전히 측정하지 못해 측정된 부분만 표시합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": " Alguns caminhos não puderam ser medidos por completo devido a limites de tempo, permissões ou volumes; é apresentada a parte medida." } },
        "ru": { "stringUnit": { "state": "translated", "value": " Некоторые пути измерены не полностью из-за ограничений времени, разрешений или границ тома; показана измеренная часть." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": " 部分路径因时限、权限或卷边界未完整测量；当前显示已测部分。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": " 部分路徑因時限、權限或卷宗邊界未完整測量；目前顯示已測部分。" } }
      }
    },
