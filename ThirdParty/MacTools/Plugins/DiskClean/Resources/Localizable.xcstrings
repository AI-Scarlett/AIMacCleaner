          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите интеллектуальное сканирование сеансов агентов, дубликатов медиа, сборок и установщиков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
