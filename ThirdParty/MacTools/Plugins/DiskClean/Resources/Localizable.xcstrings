    "category.userFiles.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه ملفات أصلية حددها المستخدم صراحةً؛ راجعها قبل نقلها إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind ausdrücklich ausgewählte Originaldateien; vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are original files explicitly selected by the user; review them before moving to Trash."
          }
        },
        "es": {
