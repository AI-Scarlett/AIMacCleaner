    "category.advisorFindings.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه بُنى سابقة أو مخرجات توزيع؛ تأكد من نسخها احتياطيًا أو رفعها أو إمكانية إعادة بنائها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind historische Builds oder Verteilungsartefakte. Prüfe, ob sie gesichert, hochgeladen oder reproduzierbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are historical builds or distribution artifacts; confirm they are backed up, uploaded, or reproducible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son compilaciones históricas o artefactos de distribución; confirma que tengan copia, estén subidos o se puedan reproducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’anciens builds ou d’artefacts de distribution ; vérifiez qu’ils sont sauvegardés, téléversés ou reproductibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴ビルドまたは配布成果物です。バックアップ済み、アップロード済み、または再ビルド可能か確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 빌드 또는 배포 산출물입니다. 백업·업로드되었거나 다시 빌드할 수 있는지 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São builds históricos ou artefactos de distribuição; confirme que têm cópia, foram enviados ou podem ser recriados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это исторические сборки или артефакты дистрибуции; убедитесь, что они сохранены, загружены или воспроизводимы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是历史构建或分发产物；请确认已备份、已上传或可以重新构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是歷史建置或發佈產物；請確認已備份、已上傳或可以重新建置。"
          }
        }
      }
    },
