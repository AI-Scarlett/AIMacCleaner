    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستشار قرص بالذكاء الاصطناعي وتنظيف Mac في مكوّن واحد: تحليل تخزين الوكلاء ونشاط الملفات والذاكرة المؤقتة ومخرجات التطوير وحزم التثبيت عبر مسار آمن موحد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Festplattenberater und Mac-Bereinigung in einem Plugin: Agent-Speicher, Dateiaktivität, Caches, Entwicklerartefakte und Installer sicher analysieren und bereinigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Disk Advisor and Mac Cleanup in one plugin: analyze Agent storage, file activity, caches, developer artifacts, and installers with one safe cleanup pipeline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asesor de disco con IA y limpieza del Mac en un complemento: analiza agentes, actividad de archivos, cachés, artefactos e instaladores con un flujo seguro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseiller de disque IA et nettoyage du Mac réunis : analyse du stockage des agents, de l’activité des fichiers, des caches, artefacts et installateurs via un processus sécurisé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ディスクアドバイザーと Mac クリーンアップを統合。Agent ストレージ、ファイル利用状況、キャッシュ、開発成果物、インストーラを共通の安全処理で分析・整理します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 디스크 어드바이저와 Mac 정리를 통합하여 Agent 저장 공간, 파일 활동, 캐시, 개발 산출물 및 설치 파일을 하나의 안전한 절차로 분석하고 정리합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultor de disco com IA e Limpeza do Mac num só plugin: analisa agentes, atividade de ficheiros, caches, artefactos e instaladores com um processo seguro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-советник и очистка Mac в одном плагине: анализ хранилища агентов, активности файлов, кэшей, артефактов и установщиков через единый безопасный процесс"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整合 AI 磁盘顾问与 Mac 清理：分析 Agent 存储、文件活跃度、缓存、开发产物和安装包，并通过统一安全流程清理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整合 AI 磁碟顧問與 Mac 清理：分析 Agent 儲存、檔案活動、快取、開發產物和安裝包，並透過統一安全流程清理"
          }
        }
      }
    },
