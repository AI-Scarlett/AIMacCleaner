    "advisor.stage.systemData": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "جارٍ تحليل مصادر بيانات النظام (للقراءة فقط)…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Systemdatenquellen werden analysiert (nur Lesen)…" } },
        "en": { "stringUnit": { "state": "translated", "value": "Breaking down System Data sources (read-only)…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Analizando los orígenes de Datos del sistema (solo lectura)…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Analyse des sources des données système (lecture seule)…" } },
        "ja": { "stringUnit": { "state": "translated", "value": "システムデータの内訳を解析中（読み取り専用）…" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 데이터 출처 분석 중(읽기 전용)…" } },
        "pt": { "stringUnit": { "state": "translated", "value": "A analisar as origens dos Dados do Sistema (só leitura)…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Анализ источников системных данных (только чтение)…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在拆分系统数据来源（只读分析）…" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在拆分系統資料來源（唯讀分析）…" } }
      }
    },
