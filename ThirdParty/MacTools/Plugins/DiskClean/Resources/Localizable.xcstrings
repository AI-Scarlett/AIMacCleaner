    "inventory.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ بيانات الملفات الوصفية فقط ويصنفها حسب التنسيق والحجم وآخر فتح أو وصول أو تعديل. تخضع الملفات المحددة لفحص أمان منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur Dateimetadaten und sortiert nach Format, Größe sowie letzter Öffnung, Nutzung und Änderung. Ausgewählte Dateien werden nochmals sicher geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads file metadata only and classifies by format, size, and last opened/accessed/modified time. Selected files still require a separate safety check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee metadatos y clasifica por formato, tamaño y última apertura, acceso o modificación. Los archivos seleccionados pasan otra comprobación de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit uniquement les métadonnées et classe par format, taille et dernière ouverture, consultation ou modification. Les fichiers choisis sont revérifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのメタデータのみを読み、形式、サイズ、最終オープン・アクセス・変更日時で分類します。選択後に別途安全確認を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 메타데이터만 읽고 형식, 크기, 마지막 열기/접근/수정 시간으로 분류합니다. 선택한 파일은 별도 안전 검사를 거칩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê apenas metadados e classifica por formato, tamanho e última abertura, acesso ou modificação. Os ficheiros escolhidos passam por nova verificação de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает только метаданные и классифицирует по формату, размеру и времени открытия, доступа или изменения. Выбранные файлы проходят отдельную проверку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读取文件元数据，按格式、大小、最后打开/访问/修改时间分类；选中后仍需单独安全检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅讀取檔案中繼資料，依格式、大小及最後開啟/存取/修改時間分類；選取後仍需單獨安全檢查。"
          }
        }
      }
    },
