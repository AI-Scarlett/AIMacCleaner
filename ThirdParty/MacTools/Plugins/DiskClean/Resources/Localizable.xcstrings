    "advisor.findings.safePipeline.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الذاكرة المؤقتة والبنيات القديمة وحزم التثبيت في تنظيف Mac. تحسب الوسائط المكررة حد التحسين فقط ولا تعدّل جلسات الوكلاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, alte Builds und Installer werden in der Mac-Bereinigung geprüft. Medienduplikate schätzen nur das Optimierungspotenzial und ändern keine Agent-Sitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review caches, old builds, and installers in Mac Cleanup. Duplicate media only estimates the optimization ceiling and never rewrites Agent sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cachés, compilaciones antiguas e instaladores en Limpieza del Mac. Los duplicados solo estiman el máximo optimizable y no modifican sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez caches, anciens builds et installateurs dans Nettoyage du Mac. Les doublons n’estiment que le potentiel et ne modifient aucune session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、古いビルド、インストーラは Mac クリーンアップで確認します。重複メディアは最適化上限のみ算出し、Agent セッションを書き換えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 이전 빌드 및 설치 파일은 Mac 정리에서 검토하세요. 중복 미디어는 최적화 가능 상한만 계산하며 Agent 세션을 수정하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja caches, compilações antigas e instaladores em Limpeza do Mac. Os duplicados apenas estimam o limite de otimização e não alteram sessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте кэши, старые сборки и установщики в очистке Mac. Дубликаты лишь оценивают предел оптимизации и не меняют сеансы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存、历史构建和安装包在“Mac 清理”中复核；重复媒体仅计算可优化上限，不直接改写 Agent 会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「Mac 清理」中覆核快取、歷史建置和安裝包；重複媒體僅估算可優化上限，不會直接改寫 Agent 工作階段。"
          }
        }
      }
    },
