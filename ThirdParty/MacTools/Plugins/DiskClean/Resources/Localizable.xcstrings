    "advisor.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحلل محليًا تخزين الوكلاء والوسائط المكررة وسجل البناء ونشاط الملفات؛ لا تتم قراءة نص المحادثات أو رفعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiert Agent-Speicher, doppelte Medien, Build-Verlauf und Dateiaktivität lokal; Unterhaltungstexte werden weder gelesen noch hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze Agent storage, duplicate media, build history, and file activity locally; conversation text is never read or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza localmente el almacenamiento de agentes, medios duplicados, compilaciones y actividad de archivos; nunca lee ni sube el texto de las conversaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse localement le stockage des agents, les médias en double, les builds et l’activité des fichiers ; le texte des conversations n’est jamais lu ni envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent ストレージ、重複メディア、ビルド履歴、ファイル利用状況をローカル分析します。会話本文は読み取りも送信もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 저장 공간, 중복 미디어, 빌드 기록 및 파일 활동을 로컬에서 분석합니다. 대화 본문은 읽거나 업로드하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa localmente o armazenamento dos agentes, multimédia duplicada, históricos de compilação e atividade dos ficheiros; o texto das conversas nunca é lido nem enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локально анализирует хранилище агентов, дубликаты медиа, историю сборок и активность файлов; текст диалогов не читается и не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机分析 Agent 存储、重复媒体、历史构建和文件活跃度；不会读取或上传对话正文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本機分析 Agent 儲存、重複媒體、歷史建置和檔案活動；不會讀取或上傳對話正文。"
          }
        }
      }
    },
