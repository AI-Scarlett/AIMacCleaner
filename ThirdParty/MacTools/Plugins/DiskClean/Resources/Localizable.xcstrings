          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが明示的に選択した元ファイルです。ゴミ箱へ移動する前に内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 명시적으로 선택한 원본 파일입니다. 휴지통으로 옮기기 전에 내용을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São ficheiros originais escolhidos pelo utilizador; reveja-os antes de os mover para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это исходные файлы, явно выбранные пользователем; проверьте их перед перемещением в Корзину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是用户主动选择的原始文件；移到废纸篓前请确认内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
